# Copiar para .env.local (dev) e cadastrar as mesmas na Vercel (produção).
# Ver PENDENCIAS.md.

# Supabase → Project Settings → API
# Obrigatória.
NEXT_PUBLIC_SUPABASE_URL=https://pjbcgyzykvidbwdjlnvp.supabase.co
# Obrigatória. Use a chave "anon" do tipo JWT (aba "Legacy API keys"), não a "publishable":
# a Edge Function pre-cadastro exige JWT no Authorization.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Número do botão "Falar com o studio" (só dígitos, com 55). Obrigatória:
# o build falha sem ela. Valor definido: o mesmo número do site atual.
NEXT_PUBLIC_WHATSAPP_STUDIO=5599984183784
